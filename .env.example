# Local development (Node.js 24)
PORT=3000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:3000
DATABASE_URL=./data/nutshell.sqlite
STORAGE_PATH=./storage

# Server-only credentials
SESSION_SECRET=
DEMO_ADMIN_TOKEN=
SESSION_TTL_DAYS=30

# StepFun text. Without a key, local development defaults to mock.
STEPFUN_API_KEY=
STEPFUN_CHAT_MODEL=step-3.5-flash
STEPFUN_API_BASE=https://api.stepfun.com/v1
# Optional photo analysis via StepFun (e.g. step-5-preview).
STEPFUN_VISION_MODEL=
CHAT_PROVIDER=
CHAT_FIRST_TOKEN_TIMEOUT_MS=15000
CHAT_CONTEXT_MAX_MESSAGES=20

# Vercel requires IMAGE_GENERATION_ENABLED=true and a key for cloud image generation.
IMAGE_GENERATION_ENABLED=
IMAGE_PROVIDER=
IMAGE_VENDOR=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_HD_MODEL=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_HD_MODEL=gemini-3-pro-image-preview
IMAGE_TIMEOUT_MS=90000
MAX_REGENERATIONS=2

# Set these in Vercel project settings for each environment.
PREVIEW_APP_URL=
PUBLIC_APP_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
