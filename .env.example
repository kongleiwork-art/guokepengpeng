# ============================================================
# 果壳碰碰 (NutShell Bump) 环境变量示例
# 复制为 .env 后按实际环境填写；密钥仅在服务端使用，不暴露给浏览器
# ============================================================

# 服务基础地址（用于生成娃娃固定链接 dollUrl 与作品链接 cardUrl）
APP_BASE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# 数据持久化与本地文件存储（部署时请挂载持久磁盘）
DATABASE_URL="./data/nutshell.sqlite"
STORAGE_PATH="./storage"

# 匿名会话 Cookie 签名密钥与有效期（天）
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_TTL_DAYS=30

# ============================================================
# 对话模型配置 (ChatProvider)
# CHAT_PROVIDER: "cloud" | "mock"
# 留空时若检测到 GEMINI_API_KEY 或 CHAT_API_KEY 自动启用 cloud，否则使用 mock
# 显式设置为 cloud 但缺少密钥时返回 PROVIDER_NOT_CONFIGURED，不静默回退
# ============================================================
CHAT_PROVIDER="cloud"
# 方式 1：使用 Gemini SDK（AI Studio 自动注入 GEMINI_API_KEY）
GEMINI_API_KEY="MY_GEMINI_API_KEY"
CHAT_MODEL="gemini-4-hydrogen"
# 方式 2：若使用 OpenAI 兼容对话接口，可填写 CHAT_API_BASE 与 CHAT_API_KEY
CHAT_API_BASE=""
CHAT_API_KEY=""

# 对话首 token 硬超时（毫秒，默认 10000；性能目标为 3000ms）
CHAT_FIRST_TOKEN_TIMEOUT_MS=10000
# 上下文历史消息上限（超过后优先保留人格、明确记忆与当前消息，裁剪最旧消息）
CHAT_CONTEXT_MAX_MESSAGES=20

# ============================================================
# 形象生成模型配置 (ImageProvider)
# IMAGE_PROVIDER: "cloud" | "mock"
# 本版亦预留 RDK 本地适配器契约（见 server/providers/rdkAdapter.ts）
# 显式设置为 cloud 但缺少密钥时返回 PROVIDER_NOT_CONFIGURED，不静默回退
# ============================================================
IMAGE_PROVIDER="mock"
# 真实云端生图可选配置（留空 IMAGE_API_BASE 时使用 Gemini Image SDK；填写时走 OpenAI 兼容生图接口）
IMAGE_API_BASE=""
IMAGE_API_KEY=""
IMAGE_MODEL="gemini-3.1-flash-lite-image"
# 生图硬超时（毫秒，默认 60000；性能目标为 40000ms）
IMAGE_TIMEOUT_MS=60000
# 初次生成后最大重生成次数（默认 2，即单卡片最多 3 次模型生成尝试）
MAX_REGENERATIONS=2

# ============================================================
# 出图执行器配置 (OutputProvider)
# 本版固定 mock，后续可扩展 arm / printer
# ============================================================
OUTPUT_PROVIDER="mock"

# ============================================================
# 演示管理与隐私清理
# ============================================================
# 受保护管理接口 (/api/demo/status, /api/demo/reset) 的授权令牌
DEMO_ADMIN_TOKEN="demo-admin-2026"
# 原始上传照片清理期限（小时，默认 24；到期后已生成结果仍保留，重生成返回 PHOTO_EXPIRED）
PHOTO_TTL_HOURS=24
