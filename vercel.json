{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "regions": ["hkg1"]
    },
    "api/step-plan-relay.ts": {
      "maxDuration": 50,
      "regions": ["sfo1"],
      "supportsCancellation": true
    },
    "api/task-worker.ts": {
      "maxDuration": 180,
      "includeFiles": "{src/assets/images/**,public/assets/materials/**}",
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "nutshell-tasks",
          "retryAfterSeconds": 30
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/internal/step-plan",
      "destination": "/api/step-plan-relay"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/nfc/:alias",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|nfc/).*)",
      "destination": "/index.html"
    }
  ]
}
